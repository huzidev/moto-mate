generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // ponytail: add `directUrl = env("DIRECT_URL")` when deploying behind a
  // connection pooler (Neon/Vercel/Supabase) that breaks schema ops.
}

// ---------- Auth (we own this; no Auth.js adapter — Credentials + JWT) ----------
model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  phone           String?
  passwordHash    String
  motorbikes      Motorbike[]
  resetTokens     PasswordResetToken[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Domain ----------
enum ServiceType {
  OIL_CHANGE
  TUNE
  CUSTOM
}

model Motorbike {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  make          String?
  model         String?
  year          Int?
  plate         String?
  city          String?
  imageUrl      String?
  odometerLogs  OdometerLog[]
  serviceEvents ServiceEvent[]
  reminders     ServiceReminder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
}

/// Each entry is a delta: "I rode X km since my last log."
/// Lifetime km = sum of all logs. Meter resets are irrelevant.
/// The "starting lifetime km" captured on bike creation is also stored here as
/// a single OdometerLog with note="starting km".
model OdometerLog {
  id          String    @id @default(cuid())
  motorbikeId String
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  km          Int
  note        String?
  loggedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([motorbikeId, loggedAt])
}

/// A service was performed at this lifetime km. Resets the counter for its type.
model ServiceEvent {
  id           String      @id @default(cuid())
  motorbikeId  String
  motorbike    Motorbike   @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  type         ServiceType
  label        String?
  atLifetimeKm Int
  note         String?
  performedAt  DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([motorbikeId, type, performedAt])
}

/// Config per bike per service type: notify every intervalKm, or after maxDays, whichever first.
model ServiceReminder {
  id             String      @id @default(cuid())
  motorbikeId    String
  motorbike      Motorbike   @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  type           ServiceType
  label          String?
  intervalKm     Int
  maxDays        Int?
  active         Boolean     @default(true)
  lastNotifiedKm Int?
  lastNotifiedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([motorbikeId, type, label])
  @@index([motorbikeId])
}
