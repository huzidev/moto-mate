generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // ponytail: add `directUrl = env("DIRECT_URL")` when deploying behind a
  // connection pooler (Neon/Vercel/Supabase) that breaks schema ops.
}

// ---------- Auth (Credentials + JWT; no adapter) ----------
model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  phone           String?
  passwordHash    String
  emailVerifiedAt DateTime?
  motorbikes      Motorbike[]
  authCodes       AuthCode[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// One row per issued 6-digit code. Code itself is bcrypt-hashed.
/// Rate-limited at the verify site: max 5 wrong attempts.
model AuthCode {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthCodePurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([userId, purpose])
}

// ---------- Domain ----------
enum ServiceType {
  OIL_CHANGE
  TUNE
  CUSTOM
}

model Motorbike {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  make          String?
  model         String?
  year          Int?
  plate         String?
  city          String?
  imageUrl      String?
  odometerLogs  OdometerLog[]
  serviceEvents ServiceEvent[]
  reminders     ServiceReminder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
}

model OdometerLog {
  id          String    @id @default(cuid())
  motorbikeId String
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  km          Int
  note        String?
  loggedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([motorbikeId, loggedAt])
}

model ServiceEvent {
  id           String      @id @default(cuid())
  motorbikeId  String
  motorbike    Motorbike   @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  type         ServiceType
  label        String?
  atLifetimeKm Int
  note         String?
  performedAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([motorbikeId, type, performedAt])
}

model ServiceReminder {
  id             String      @id @default(cuid())
  motorbikeId    String
  motorbike      Motorbike   @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  type           ServiceType
  label          String?
  intervalKm     Int
  maxDays        Int?
  active         Boolean     @default(true)
  lastNotifiedKm Int?
  lastNotifiedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([motorbikeId, type, label])
  @@index([motorbikeId])
}
